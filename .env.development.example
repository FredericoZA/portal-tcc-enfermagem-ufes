# Somente desenvolvimento local. Nunca copie estes valores para a Vercel.
NODE_ENV="development"
PORT="3000"
PORTAL_ALLOW_INSECURE_DEMO_AUTH="true"
PORTAL_ALLOW_LOCAL_OTP_STORE="true"
PORTAL_ALLOW_LOCAL_SECRET_STORE="true"
PORTAL_TEST_DOCUMENT_RENDERER="true"

# Segredos fixos APENAS para desenvolvimento local.
# Permitem testar sessão/OTP sem depender da Vercel, Gmail ou Supabase.
PORTAL_SESSION_SECRET="local-only-session-secret-portal-tcc-00000001"
PORTAL_OTP_PEPPER="local-only-otp-pepper-portal-tcc-0000000002"
PORTAL_OTP_DELIVERY_MODE="log"
PORTAL_OTP_TEST_CODE="123456"
