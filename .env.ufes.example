# Perfil de instalação TCC Enfermagem UFES — preparado em 10/09/2026.
# Supabase institucional confirmado. Equipe Vercel pretendida: tcc-enfermagem; acesso pendente.
# Credenciais do servidor Supabase e OAuth Google ainda pendentes.
# URL pública exata da implantação, sem barra final.
APP_URL="https://portal-tcc-enfermagem-ufes.vercel.app"
PORTAL_PUBLIC_URL="https://portal-tcc-enfermagem-ufes.vercel.app"
NODE_ENV="production"

# Sessão e OTP: gere valores aleatórios independentes com pelo menos 32 bytes.
PORTAL_SESSION_SECRET=""
PORTAL_OTP_PEPPER=""
PORTAL_BOOTSTRAP_MASTER_EMAIL="tccenfermagemufes@gmail.com"
PORTAL_ALLOW_INSECURE_DEMO_AUTH="false"
PORTAL_ALLOW_LOCAL_OTP_STORE="false"
PORTAL_ALLOW_LOCAL_SECRET_STORE="false"

# Chave AES-256-GCM: 64 caracteres hexadecimais ou 32 bytes em Base64.
PORTAL_SECRET_ENCRYPTION_KEY=""
PORTAL_VERIFICATION_SECRET=""
PORTAL_UPLOAD_BINDING_SECRET=""
# A Vercel envia este segredo como Bearer no agendamento diário de limpeza.
# Use um valor aleatório próprio, diferente de todos os outros segredos.
CRON_SECRET=""

# Supabase privado do backend. Nunca use prefixo VITE_ nestas chaves.
PORTAL_PERSISTENCE_PROVIDER="supabase"
SUPABASE_URL="https://vvgdmycmotazqjvpywmk.supabase.co"
SUPABASE_SECRET_KEY=""
SUPABASE_SECURE_FILES_BUCKET="portal-secure-transfer"
PORTAL_DRIVE_ROOT_FOLDER_ID="1zkG3fBm2tJESZjZP0_7jStUuPNXCwRPS"

# OAuth da conta Google do portal. Callback:
# https://portal-tcc-enfermagem-ufes.vercel.app/api/integrations/google/oauth/callback
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_STATE_SECRET=""
# Padrão seguro: modelos entram por upload DOCX. Ativar exige nova autorização
# Google com escopo drive.readonly para importar arquivos preexistentes por link.
GOOGLE_ALLOW_EXISTING_MODEL_LINKS="false"

# Asten. O token da conta é inserido pela tela de Configurações e guardado
# criptografado no Supabase; ele não deve ser colocado neste arquivo.
ASTEN_INTEGRATION_ENABLED="true"
ASTEN_REPOSITORY_ID=""
ASTEN_AUTHENTICATION_OPTION="4"
ASTEN_REQUIRE_LOGIN="true"
ASTEN_REQUIRE_CODE="true"
ASTEN_CALLBACK_URL="https://portal-tcc-enfermagem-ufes.vercel.app/api/integrations/asten/webhook"
ASTEN_WEBHOOK_SECRET=""

# Recuperação do Master: somente o SHA-256, nunca a chave em texto puro.
MASTER_RECOVERY_SECRET_SHA256=""
