# Exemplo de produção para uma instalação institucional do Portal TCC.
# Nunca copie segredos, IDs de pastas ou identificadores da instalação UFES para outra implantação.
# Preencha os valores próprios da sua instituição somente no provedor de hospedagem ou em .env local ignorado pelo Git.

APP_URL="https://SEU-PORTAL.vercel.app"
PORTAL_PUBLIC_URL="https://SEU-PORTAL.vercel.app"
NODE_ENV="production"

# Sessão e OTP: gere valores aleatórios independentes com pelo menos 32 bytes.
PORTAL_SESSION_SECRET=""
PORTAL_OTP_PEPPER=""
PORTAL_BOOTSTRAP_MASTER_EMAIL="master@instituicao.example"
PORTAL_ALLOW_INSECURE_DEMO_AUTH="false"
PORTAL_ALLOW_LOCAL_OTP_STORE="false"
PORTAL_ALLOW_LOCAL_SECRET_STORE="false"

# Chave AES-256-GCM: 64 caracteres hexadecimais ou 32 bytes em Base64.
PORTAL_SECRET_ENCRYPTION_KEY=""
PORTAL_VERIFICATION_SECRET=""
PORTAL_UPLOAD_BINDING_SECRET=""
CRON_SECRET=""

# Supabase privado do backend. Nunca use prefixo VITE_ nestas chaves.
PORTAL_PERSISTENCE_PROVIDER="supabase"
SUPABASE_URL="https://SEU-PROJETO.supabase.co"
SUPABASE_SECRET_KEY=""
SUPABASE_SECURE_FILES_BUCKET="portal-secure-transfer"
PORTAL_DRIVE_ROOT_FOLDER_ID="ID_DA_PASTA_RAIZ_DO_DRIVE"

# OAuth da conta Google institucional do portal.
# Callback esperado: https://SEU-PORTAL.vercel.app/api/integrations/google/oauth/callback
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_STATE_SECRET=""
# Use true apenas quando a instalação precisar cadastrar modelos Google Docs já existentes.
GOOGLE_ALLOW_EXISTING_MODEL_LINKS="true"

# Asten. O token da conta é inserido pela tela de Configurações e guardado
# criptografado no banco; ele nunca deve ser colocado neste arquivo ou no Git.
ASTEN_INTEGRATION_ENABLED="true"
ASTEN_REPOSITORY_ID=""
ASTEN_AUTHENTICATION_OPTION="4"
ASTEN_REQUIRE_LOGIN="true"
ASTEN_REQUIRE_CODE="true"
ASTEN_CALLBACK_URL="https://SEU-PORTAL.vercel.app/api/integrations/asten/webhook"
ASTEN_WEBHOOK_SECRET=""

# Recuperação do Master: somente o SHA-256, nunca a chave em texto puro.
MASTER_RECOVERY_SECRET_SHA256=""
