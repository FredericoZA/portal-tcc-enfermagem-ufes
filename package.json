{
  "name": "portal-tcc-institucional",
  "private": true,
  "version": "1.0.44",
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "prebuild": "npm run clean",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server/server.cjs",
    "start": "node scripts/start-production.mjs",
    "clean": "node scripts/clean-build.mjs",
    "lint": "tsc --noEmit",
    "test:secrets": "node scripts/check-no-secrets.mjs",
    "test:unit": "node --import tsx --test \"server/**/*.test.ts\"",
    "test:contracts": "node --import tsx --test server/integrations/providerContracts.test.ts",
    "test:secure-flow": "node scripts/test-secure-flow.mjs",
    "test:a11y": "node scripts/test-accessibility-static.mjs",
    "test:http": "node scripts/test-http-build.mjs",
    "test:finalization": "node scripts/test-finalization-contract.mjs",
    "test:ci": "npm run test:secrets && npm run lint && npm run test:unit && npm run test:contracts && npm run test:a11y && npm run test:finalization && npm run build && npm run test:http",
    "release:zip": "node scripts/package-release.mjs",
    "test:visual": "node scripts/test-visual.mjs",
    "test:visual:compare": "node scripts/compare-visual.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "googleapis": "^173.0.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}