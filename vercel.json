{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "work/finalizacao-portal-tcc": false,
      "work/padronizacao-visual-setembro-2026": false,
      "work/ajustes-visuais-1.0.35": false,
      "work/correcao-visual-1.0.36": false,
      "work/sidebar-accent-full-height": false
    }
  },
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "regions": [
    "gru1"
  ],
  "env": {
    "APP_URL": "https://portal-tcc-enfermagem-ufes.vercel.app",
    "PORTAL_PUBLIC_URL": "https://portal-tcc-enfermagem-ufes.vercel.app",
    "PORTAL_BOOTSTRAP_MASTER_EMAIL": "tccenfermagemufes@gmail.com",
    "PORTAL_ALLOW_INSECURE_DEMO_AUTH": "false",
    "PORTAL_ALLOW_LOCAL_OTP_STORE": "false",
    "PORTAL_ALLOW_LOCAL_SECRET_STORE": "false",
    "PORTAL_PERSISTENCE_PROVIDER": "supabase",
    "SUPABASE_URL": "https://vvgdmycmotazqjvpywmk.supabase.co",
    "SUPABASE_SECURE_FILES_BUCKET": "portal-secure-transfer",
    "PORTAL_DRIVE_ROOT_FOLDER_ID": "1zkG3fBm2tJESZjZP0_7jStUuPNXCwRPS",
    "GOOGLE_ALLOW_EXISTING_MODEL_LINKS": "true",
    "ASTEN_INTEGRATION_ENABLED": "false",
    "ASTEN_AUTHENTICATION_OPTION": "4",
    "ASTEN_REQUIRE_LOGIN": "true",
    "ASTEN_REQUIRE_CODE": "true",
    "ASTEN_CALLBACK_URL": "https://portal-tcc-enfermagem-ufes.vercel.app/api/integrations/asten/webhook"
  },
  "functions": {
    "api/index.ts": {
      "maxDuration": 300,
      "includeFiles": "dist/server/**"
    },
    "api/replication-model.ts": {
      "maxDuration": 60
    },
    "api/runtime-asset.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/storage-cleanup",
      "schedule": "17 3 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self), payment=(), usb=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        },
        {
          "key": "Origin-Agent-Cluster",
          "value": "?1"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://vvgdmycmotazqjvpywmk.supabase.co https://nominatim.openstreetmap.org; frame-src 'self' https://www.google.com https://maps.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/public/runtime-assets/:key",
      "destination": "/api/runtime-asset?key=:key"
    },
    {
      "source": "/api/public/replication-models/:slug/download",
      "destination": "/api/replication-model?slug=:slug"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}